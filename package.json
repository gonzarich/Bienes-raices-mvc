{
  "name": "bienesraices.mvc",
  "version": "1.0.0",
  "description": "Mi Primer Proyecto de Node.js",
  "keywords": [
    "MVC",
    "Pug",
    "Tailwind",
    "MySQL",
    "Sequelize"
  ],
  "license": "ISC",
  "author": "Gonzarich",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "server": "nodemon index.js",
    "css": "postcss ./public/css/tailwind.css -o ./public/css/app.css --watch",
    "js": "webpack --watch",
    "dev": "concurrently \"npm run css\" \"npm run js\"",
    "db:importar": "node ./seed/seeder.js -i",
    "db:eliminar": "node ./seed/seeder.js -e"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.30",
    "postcss-cli": "^12.0.0",
    "tailwindcss": "^3.4.19",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "csurf": "^1.11.0",
    "dotenv": "^18.0.8",
    "dropzone": "^5.9.3",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.2.1",
    "pug": "^3.0.4",
    "sequelize": "^6.37.8"
  }
}